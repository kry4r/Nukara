server {
  listen ${ADMIN_WEB_PORT};
  server_name ${DOMAIN};

  location / {
    root ${ADMIN_WEB_ROOT};
    try_files $uri $uri/ /index.html;
  }

  location /api/admin/ {
    proxy_pass http://127.0.0.1:${ADMIN_API_PORT}/api/admin/;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
  }

  location /health {
    proxy_pass http://127.0.0.1:${ADMIN_API_PORT}/health;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
  }
}
